# Every environment variable your app needs, with harmless placeholder values.
# Copy to .env for local use. Real values go into your hosting provider's settings, never into git.
# In a codespace, put the secret ones in the repository's Codespaces secrets instead of a file.
PORT=3000
# SQLite database path. Docker sets this to /data/club_events.db.
DB_PATH=database/club_events.db
# Set to 1 only when running behind a trusted TLS-terminating reverse proxy.
TRUST_PROXY=0
# DATABASE_URL, PUBLIC_BASE_URL, and MODEL_NAME below are legacy template
# placeholders; the current application does not read them.
DATABASE_URL=postgres://user:password@host/dbname
# Session secret for cookie signing. Generate a strong random secret locally using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
PUBLIC_BASE_URL=http://localhost:3000

# Google OpenID Connect. Set all three values to enable the authorization-code sign-in flow.
# Register the exact redirect URI in Google Cloud; HTTP is allowed only for localhost.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# The model feature. The current Gemini client uses gemini-2.0-flash directly;
# MODEL_NAME is not currently read. Without this key, deterministic fallback works.
GEMINI_API_KEY=
MODEL_NAME=gemini-2.5-flash

# Trusted local student identity for the MCP server. Registration uses this process-level
# user ID and never accepts a user ID from tool arguments.
MCP_USER_ID=
