{
  "name": "webdev-273223019",
  "version": "1.0.0",
  "description": "This repository is your workspace for the whole course: Exercise 1 in `mcp-server/`, and your project (Exercises 2–5) in the rest of it. Everything runs in your browser through GitHub Codespaces, so nothing needs to be installed on your laptop.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node scripts/run-tests.js",
    "coverage": "npm run coverage:project; project_status=$?; npm run coverage:services; services_status=$?; test $project_status -eq 0 && test $services_status -eq 0",
    "coverage:project": "c8 --all --include='src/**/*.js' --reporter=text-summary --check-coverage --lines 80 --functions 80 --branches 80 npm test",
    "coverage:services": "c8 --all --include='src/services/**/*.js' --reporter=text --check-coverage --lines 100 --functions 100 --branches 100 npm test",
    "start": "node src/server.js",
    "mcp": "node mcp-server/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IceCrqme/webdev-273223019.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/IceCrqme/webdev-273223019/issues"
  },
  "homepage": "https://github.com/IceCrqme/webdev-273223019#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.2.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-session": "^1.19.0"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "mocha": "^12.0.3",
    "supertest": "^7.3.2"
  }
}
